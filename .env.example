# Copy this file to .env and paste in a real key - .env is gitignored, this
# template is committed so anyone setting up the project knows what's needed.
OPENROUTER_API_KEY=

# Signs every login token (api/auth.py) - the app refuses to start without
# this. Any random string works for a demo; rotating it invalidates every
# signed-in session at once (there's no other revocation mechanism).
AUTH_SECRET=
